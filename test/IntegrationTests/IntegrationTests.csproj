<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
  <PropertyGroup>
    <Authors>chris mckee, hotchkj</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <IsPackable>false</IsPackable>
    <!-- Disable analyzer warning since AWS SDK has incorrect versioning behaviour -->
    <!-- 1701;1702;1705 are Microsoft advice - cargo culting -->
    <NoWarn>1701;1702;1705;IDE1002;NU1901;NU1904</NoWarn>
    <!-- Workaround for https://github.com/Microsoft/msbuild/issues/2274 -->
    <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RootNamespace>AspNetCore.DataProtection.Aws.IntegrationTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AspNet.DataProtection.Aws.Kms\AspNet.DataProtection.Aws.Kms.csproj" />
    <ProjectReference Include="..\..\src\AspNet.DataProtection.Aws.S3\AspNet.DataProtection.Aws.S3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config.json" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="localstack\aws-seed-data\init.sh">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="localstack\aws-seed-data\scripts\*.sh">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FakeItEasy" Version="9.0.1" />
    <PackageReference Update="Testcontainers.LocalStack" Version="4.13.0" />
    <PackageReference Update="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
    <PackageReference Update="Microsoft.Testing.Extensions.CrashDump" Version="2.3.3" />
    <PackageReference Update="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageReference Update="Microsoft.Testing.Platform" Version="2.3.3" />
    <PackageReference Update="Nito.AsyncEx.Coordination" Version="5.1.2" />
  </ItemGroup>

</Project>